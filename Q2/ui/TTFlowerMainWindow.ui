 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>700</width>
    <height>550</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Quản Lý Bán Hàng - Cửa Hàng Hoa Thanh Thản</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QMainWindow {
        background-image: url(d:/Tuduylaptrinh/review_midterm/midterm1/Q2/images/flower_shop.jpg);
        background-position: center;
        background-repeat: no-repeat;
    }
    QWidget#centralwidget {
        background: transparent;
    }
    QGroupBox {
        font-weight: bold;
        font-size: 13px;
        border: 1px solid #C8E6C9;
        border-radius: 8px;
        margin-top: 10px;
        padding-top: 10px;
        background-color: rgba(255, 255, 255, 205);
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        subcontrol-position: top left;
        padding: 0 5px;
		color: #2E7D32;
    }
    QLabel {
        font-size: 13px;
        color: #333333;
    }
    QLineEdit {
        border: 1px solid #BDBDBD;
        border-radius: 4px;
        padding: 5px;
        font-size: 13px;
        background-color: rgba(255, 255, 255, 220);
    }
    QLineEdit:focus {
        border: 1px solid #4CAF50;
        background-color: #FFFFFF;
    }
    QLineEdit[readOnly=&quot;true&quot;] {
        background-color: rgba(232, 245, 233, 220);
        color: #1B5E20;
        font-weight: bold;
    }
    QPushButton {
        background-color: rgba(76, 175, 80, 220);
        color: white;
        font-size: 13px;
        font-weight: bold;
        border-radius: 5px;
        padding: 8px 15px;
        min-width: 100px;
    }
    QPushButton:hover {
        background-color: #43A047;
    }
    QPushButton:pressed {
        background-color: #2E7D32;
    }
    QPushButton#pushButtonClear {
        background-color: rgba(255, 152, 0, 220);
    }
    QPushButton#pushButtonClear:hover {
        background-color: #FB8C00;
    }
    QPushButton#pushButtonClose {
        background-color: rgba(229, 57, 53, 220);
    }
    QPushButton#pushButtonClose:hover {
        background-color: #D32F2F;
    }
   </string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout_Main">
    <property name="spacing">
     <number>15</number>
    </property>
    <property name="leftMargin">
